{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:0thernes:build-standard:repo-manifest-schema:1.2.0",
  "title": "repo.yaml: project manifest for the Build Standard for LLMs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "standard",
    "name",
    "description",
    "owner",
    "year",
    "project_type",
    "stack",
    "flags",
    "items"
  ],
  "properties": {
    "standard": {
      "type": "string",
      "description": "Build Standard version this repo targets"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "year": {
      "type": [
        "string",
        "integer"
      ]
    },
    "project_type": {
      "enum": [
        "library",
        "cli",
        "service",
        "web-app",
        "desktop-app",
        "mobile-app",
        "data",
        "ml",
        "ai-app",
        "research",
        "docs",
        "infra",
        "game",
        "other"
      ]
    },
    "stack": {
      "type": "array",
      "items": {
        "enum": [
          "node",
          "python",
          "rust",
          "go",
          "ruby",
          "java",
          "c-cpp",
          "dotnet",
          "swift",
          "kotlin",
          "php",
          "elixir",
          "haskell",
          "zig",
          "other"
        ]
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "published openly (community files, About, citation)"
        },
        "package": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "installable library or tool (auto: a package manifest exists)"
        },
        "visual": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "has visible output worth a screenshot or GIF (auto: ui)"
        },
        "ui": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "has a user interface (auto: tsx/jsx/vue/svelte/html/xaml/swift files outside docs)"
        },
        "native": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "native or unsafe code (auto: C/C++/asm sources)"
        },
        "ai": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "calls or ships an AI model (auto: AI SDK names in code or manifests)"
        },
        "personal_data": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "collects, stores, processes or logs personal data"
        },
        "service": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "long-running service, server or job"
        },
        "deployed": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "deployed somewhere"
        },
        "api": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "exposes or consumes an API, file format or protocol"
        },
        "perf": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "makes speed or efficiency claims"
        },
        "concurrent": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "concurrent, parallel or async code"
        },
        "numeric": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "numeric, scientific, financial, ML or simulation code"
        },
        "experimental": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "makes experimental, statistical or research claims"
        },
        "ml": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "trains, fine-tunes or selects ML models"
        },
        "formal": {
          "enum": [
            true,
            false,
            "auto"
          ],
          "description": "has a critical core worth formal methods"
        }
      }
    },
    "items": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[AB](0[1-9]|[1-3][0-9]|4[0-5])$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "done",
                "todo",
                "partial",
                "n/a"
              ]
            },
            "evidence": {
              "type": "string"
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
